{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SmartPrep revision result",
  "type": "object",
  "required": [
    "revisionResultId",
    "revisionEventId",
    "conceptId",
    "score",
    "difficultyRating",
    "timestamp"
  ],
  "properties": {
    "difficultyRating": {
      "enum": [
        "FAILED",
        "DIFFICULT",
        "PARTIAL",
        "EASY"
      ]
    },
    "score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "nextRevisionDate": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}