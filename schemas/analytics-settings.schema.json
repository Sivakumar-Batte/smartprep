  "required": [
    "masteryAttempts",
    "masteryAccuracy"
  ],
  "properties": {
    "masteryAttempts": {
      "type": "integer",
      "minimum": 1
    },
    "masteryAccuracy": {
      "type": "number",
      "minimum": 1,
      "maximum": 100
    }
  },
  "additionalProperties": false
}